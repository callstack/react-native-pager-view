# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'PagerViewExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode's compiler launcher keeps explicit modules enabled, unlike RN's
    # ccache CC wrapper (USE_CCACHE), so don't combine the two.
    if ENV['USE_CCACHE_LAUNCHER'] == '1'
      ccache_path = `command -v ccache`.strip
      if ccache_path.empty?
        Pod::UI.warn('[Ccache] USE_CCACHE_LAUNCHER=1 but ccache was not found on PATH')
      else
        Pod::UI.puts("[Ccache] Using #{ccache_path} as C_COMPILER_LAUNCHER")
        projects = [installer.pods_project]
        projects += installer.aggregate_targets.map(&:user_project).compact
        projects.uniq { |project| project.path }.each do |project|
          project.build_configurations.each do |config|
            config.build_settings['C_COMPILER_LAUNCHER'] = ccache_path
            config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES_WITH_COMPILER_LAUNCHER'] = 'YES'
          end
          project.save
        end
      end
    end

    # Xcode rejects deployment targets below 15.0, and RN's own post_install
    # skips resource-bundle targets, so RNSVG's bundles keep the podspec's 12.4.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.1
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end
    end
  end
end
