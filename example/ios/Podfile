ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-test-app/test_app.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-test-app/test_app.rb"

workspace 'PagerViewExample.xcworkspace'

options = {
  :bridgeless_enabled => true,
  :fabric_enabled => true,
  :hermes_enabled => true,
  # Xcode 27 rejects deployment targets below 15.0, and RN's own post_install
  # skips resource-bundle targets, so RNSVG's bundles keep the podspec's 12.4.
  :post_install => lambda { |installer|
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.1
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end
    end
  },
}

use_test_app! options
